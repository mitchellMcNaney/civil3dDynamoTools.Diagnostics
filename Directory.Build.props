<Project>

  <!--
    Civil 3D 2026 / AutoCAD 2026 install locations, overridable per machine without
    touching the .csproj:
      - set environment variables AUTOCAD2026_ROOT / CIVIL3D_ROOT, or
      - pass /p:AutoCAD2026Root=... /p:Civil3DRoot=... on the command line, or
      - edit the defaults below.
    Civil3DRoot must point at the real Civil 3D managed assemblies (the "...\C3D" folder
    under the AutoCAD 2026 install), not an Object Enabler copy of the same DLL names.
  -->
  <PropertyGroup>
    <AutoCAD2026Root Condition="'$(AutoCAD2026Root)'==''">$(AUTOCAD2026_ROOT)</AutoCAD2026Root>
    <AutoCAD2026Root Condition="'$(AutoCAD2026Root)'==''">C:\Program Files\Autodesk\AutoCAD 2026</AutoCAD2026Root>

    <Civil3DRoot Condition="'$(Civil3DRoot)'==''">$(CIVIL3D_ROOT)</Civil3DRoot>
    <Civil3DRoot Condition="'$(Civil3DRoot)'==''">$(AutoCAD2026Root)\C3D</Civil3DRoot>
  </PropertyGroup>

</Project>
