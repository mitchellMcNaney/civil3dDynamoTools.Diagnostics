<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Civil 3D 2026 (R25.1+) and 2027 both host .NET 10. Built against the 2026 references,
         the lowest supported host; the same DLL runs in 2027 (validated). -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>CivilDynamoTools.Diagnostics</RootNamespace>
    <AssemblyName>CivilDynamoTools.Diagnostics</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- COM interop (dynamic + IDispatch late binding) is used to reach AeccParcel /
         ParcelLoops. No Autodesk COM interop assembly is referenced. -->
    <EnableComHosting>false</EnableComHosting>
  </PropertyGroup>

  <ItemGroup>
    <!-- AutoCAD managed API. Copy Local = false: these are supplied by the host
         process (Civil 3D) at runtime and must not ship inside the package. -->
    <Reference Include="AcCoreMgd">
      <HintPath>$(AutoCADRoot)\AcCoreMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcDbMgd">
      <HintPath>$(AutoCADRoot)\AcDbMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcMgd">
      <HintPath>$(AutoCADRoot)\AcMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Civil 3D managed API (Parcel, ParcelSegment, Site, CivilDocument, ...). -->
    <Reference Include="AeccDbMgd">
      <HintPath>$(Civil3DRoot)\AeccDbMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AecBaseMgd">
      <HintPath>$(AutoCADRoot)\ACA\AecBaseMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Pure geometry (no Autodesk refs). Copy Local = true: it ships next to this DLL. -->
    <ProjectReference Include="..\CivilDynamoTools.Diagnostics.Geometry\CivilDynamoTools.Diagnostics.Geometry.csproj" />
  </ItemGroup>

</Project>
